{
  "manifest_version": 3,
  "name": "Canvas Refined",
  "description": "Even More Feature packed extension for Canvas.",
  "version": "7.0.2",
  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  },
  "action": {
    "default_icon": {
      "19": "icon/icon-19.png",
      "38": "icon/icon-38.png"
    },
    "default_popup": "html/popup.html",
    "default_title": "Canvas Refined"
  },
  "background": {
    "scripts": ["js/background.js"],
    "service_worker": "js/background.js"
  },
  "options_page": "html/options.html",
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": [
        "css/darkmodecss.js",
        "js/content/backgrounds.js",
        "js/content/dashboard/markdown.js",
        "js/content/nav.js",
        "js/content/todo/todoreminders.js",
        "js/content/todo/bettertodo.js",
        "js/content/bettersidebar.js",
        "js/content/dashboard/cardcolors.js",
        "js/content/styling/darkmode.js",
        "js/content/dashboard/grades.js",
        "js/content/dashboard/cardassignments.js",
        "js/content/dashboard/cardcustomization.js",
        "js/content/dashboard/gpacalc.js",
        "js/content/dashboard/dashboardnotes.js",
        "js/content/styling/customfont.js",
        "js/content/content.js",
        "js/content/globalsearch/searchmain.js",
        "js/content/globalsearch/indexing.js",
        "js/content/globalsearch/searching.js",
        "js/content/misc.js",
        "js/content/gradeanalytics/gamain.js",
        "js/content/gradeanalytics/gaimagine.js",
        "js/utils.js"
      ],
      "css": ["css/content.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "unlimitedStorage"],
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "canvasrefined@guysan.site",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
