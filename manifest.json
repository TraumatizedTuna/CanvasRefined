{
  "manifest_version": 3,
  "name": "Canvas Refined",
  "description": "Even More Feature packed extension for Canvas.",
  "version": "7.0.2",
  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  },
  "action": {
    "default_icon": {
      "19": "icon/icon-19.png",
      "38": "icon/icon-38.png"
    },
    "default_popup": "html/popup.html",
    "default_title": "Canvas Refined"
  },
  "background": {
    "scripts": ["js/background.js"],
    "service_worker": "js/background.js"
  },
  "options_page": "html/options.html",
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": [
        "css/darkmodecss.js",
        "js/backgrounds.js",
        "js/markdown.js",
        "js/nav.js",
        "js/todo/todoreminders.js",
        "js/todo/bettertodo.js",
        "js/bettersidebar.js",
        "js/dashboard/cardcolors.js",
        "js/styling/darkmode.js",
        "js/dashboard/grades.js",
        "js/dashboard/cardassignments.js",
        "js/dashboard/cardcustomization.js",
        "js/dashboard/gpacalc.js",
        "js/dashboard/dashboardnotes.js",
        "js/styling/customfont.js",
        "js/content.js",
        "js/globalsearch/searchmain.js",
        "js/globalsearch/indexing.js",
        "js/globalsearch/searching.js",
        "js/misc.js",
        "js/gradeanalytics/gamain.js",
        "js/gradeanalytics/gaimagine.js",
        "js/utils.js",
        "time-edit-api/index.js",
        "js/test.js"
      ],
      "css": ["css/content.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "unlimitedStorage"],
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "canvasrefined@guysan.site",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
